generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Member {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  scores   Score[]
}

model Course {
  id    Int    @id @default(autoincrement())
  name  String @unique
  par1  Int    @default(4)
  par2  Int    @default(4)
  par3  Int    @default(4)
  par4  Int    @default(4)
  par5  Int    @default(4)
  par6  Int    @default(4)
  par7  Int    @default(4)
  par8  Int    @default(4)
  par9  Int    @default(4)
  par10 Int    @default(4)
  par11 Int    @default(4)
  par12 Int    @default(4)
  par13 Int    @default(4)
  par14 Int    @default(4)
  par15 Int    @default(4)
  par16 Int    @default(4)
  par17 Int    @default(4)
  par18 Int    @default(4)
}

model Round {
  id                 Int           @id @default(autoincrement())
  date               DateTime      @default(now())
  course             String
  note               String?
  scorecardImagePath String?
  scores             Score[]
  gallery            GalleryItem[]
}

model Score {
  id       Int    @id @default(autoincrement())
  strokes  Int
  h1       Int
  h2       Int
  h3       Int
  h4       Int
  h5       Int
  h6       Int
  h7       Int
  h8       Int
  h9       Int
  h10      Int
  h11      Int
  h12      Int
  h13      Int
  h14      Int
  h15      Int
  h16      Int
  h17      Int
  h18      Int
  memberId Int
  roundId  Int
  member   Member @relation(fields: [memberId], references: [id])
  round    Round  @relation(fields: [roundId], references: [id])

  @@index([memberId])
  @@index([roundId])
}

model GalleryItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  filePath    String
  createdAt   DateTime @default(now())
  tags        String   @default("")
  groupId     String?
  isCover     Boolean  @default(false)
  roundId     Int?
  round       Round?   @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@index([roundId])
}

model WinnerComment {
  id         Int      @id @default(autoincrement())
  winnersKey String
  roundDate  DateTime
  author     String   @default("익명")
  message    String
  createdAt  DateTime @default(now())
}

model BettingNotice {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
